# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=flames_photography
MYSQL_USER=root
MYSQL_PASSWORD=

# PERSISTENT_STORAGE_PATH: Absolute path OUTSIDE this git repository where
# uploaded media and the JSON fallback datastore are written. Leave unset
# for local development (defaults to ./storage inside the repo).
#
# ON PRODUCTION (HOSTINGER) THIS MUST BE SET, or every redeploy from GitHub
# can wipe uploaded images and site content - see server/config/storage.ts
# for the full explanation. Example:
# PERSISTENT_STORAGE_PATH=/home/your-hostinger-username/dflamez-persistent-storage
PERSISTENT_STORAGE_PATH=

# Session / JWT Secret
# REQUIRED in production - the server refuses to start without it (see
# server/config/auth.ts). Must be a long, random, unique string - never reuse
# this across projects or environments. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ALLOWED_ORIGINS: comma-separated list of origins allowed to make
# credentialed cross-origin requests to this API (CORS). In production this
# should normally just be your own site's origin(s), e.g.:
#   ALLOWED_ORIGINS=https://dflamez.com.ng,https://www.dflamez.com.ng
# Leave unset in local development.
ALLOWED_ORIGINS=

# SMTP Email Configuration (for booking notifications + client confirmations)
# Never hardcode real credentials here or anywhere in the codebase - set the
# real values as environment variables in Hostinger's app panel instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM: the "from" address emails are sent as. Defaults to SMTP_USER if unset.
SMTP_FROM=
# STUDIO_NOTIFICATION_EMAIL: where new booking notifications are sent. Defaults to SMTP_USER if unset.
STUDIO_NOTIFICATION_EMAIL=
